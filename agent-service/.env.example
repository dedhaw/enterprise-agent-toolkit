# ── App ──────────────────────────────────────────────────────────────────────
# APP_MODE: local | test | prod  (defaults to prod if unset)
APP_MODE=local

# ── Models ───────────────────────────────────────────────────────────────────
GENERAL_MODEL=qwen3:4b
INTENT_MODEL=qwen3:4b

# ── Ollama (APP_MODE=local) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Azure OpenAI (APP_MODE=test or prod) ─────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── AWS Bedrock (APP_MODE=test or prod) ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/agent.db
CHROMA_PATH=./data/chromadb

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Optional: URL of external log ingest (Datadog, Langfuse, etc.)
LOG_SERVICE_URL=
