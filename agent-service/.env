# ── App ──────────────────────────────────────────────────────────────────────
# APP_MODE: local | test | prod
# local = Ollama direct, no infra required
# prod  = LiteLLM gateway + Postgres + Langfuse (requires agent-infra stack)
APP_MODE=prod

# ── Models ───────────────────────────────────────────────────────────────────
GENERAL_MODEL=qwen3:4b
INTENT_MODEL=qwen3:4b

# ── Ollama (APP_MODE=local only) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── LiteLLM gateway (APP_MODE=prod, Intel infra) ─────────────────────────────
# Routes all LLM traffic through LiteLLM for auth, rate limiting, and observability
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-6a6f751b5716bff7a396

# ── Azure OpenAI (APP_MODE=test or prod, if using Azure instead of LiteLLM) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── AWS Bedrock (APP_MODE=test or prod, if using AWS instead of LiteLLM) ─────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres from Intel infra (agentdb schema, pgvector enabled)
DATABASE_URL=postgresql://agentuser:wLsx5AxhuBxdbXKRQv4L@localhost:5432/agentdb
# Fallback SQLite path (used when DATABASE_URL is empty)
DB_PATH=./data/agent.db
CHROMA_PATH=./data/chromadb

# ── Langfuse observability ────────────────────────────────────────────────────
# View traces at http://localhost:3002 (admin@admin.com / see agent-infra/.env)
LANGFUSE_PUBLIC_KEY=lf_pk_4e760ea53871a4fb8c6b
LANGFUSE_SECRET_KEY=lf_sk_d10d49cefa3ef6a51100
LANGFUSE_HOST=http://localhost:3002

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_SERVICE_URL=
