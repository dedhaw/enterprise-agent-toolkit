# ── App ──────────────────────────────────────────────────────────────────────
# APP_MODE: local | test | prod  (defaults to prod if unset)
APP_MODE=local

# ── Models ───────────────────────────────────────────────────────────────────
# Name of the primary model used by agents
GENERAL_MODEL=qwen3:4b
# Name of the lightweight model used by the intent agent (tool routing)
INTENT_MODEL=qwen3:4b

# ── Ollama (APP_MODE=local) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Azure OpenAI (APP_MODE=test or prod, if using Azure) ─────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── AWS Bedrock (APP_MODE=test or prod, if using AWS) ────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./data/agent.db
CHROMA_PATH=./data/chromadb

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to send logs to an external service (e.g. Langfuse, Datadog ingest URL)
LOG_SERVICE_URL=
